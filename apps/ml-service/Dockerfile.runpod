# ───────────────────────────────────────────────────────────────────
# Imagenix ML Service — RunPod Deployment Image
# ───────────────────────────────────────────────────────────────────
# This image pre-downloads all model weights at build time so that
# pod startup is fast (no waiting for multi-GB downloads).
#
# Build:
#   docker build -f Dockerfile.runpod -t imagenix-ml-runpod .
#
# Push:
#   docker tag imagenix-ml-runpod your-registry/imagenix-ml-runpod:latest
#   docker push your-registry/imagenix-ml-runpod:latest
# ───────────────────────────────────────────────────────────────────

FROM runpod/pytorch:2.2.0-py3.11-cuda12.1.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# System dependencies for OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# ── Pre-download model weights ──────────────────────────────────────
# This caches weights inside the image layer so RunPod pods start fast.
RUN python -c "\
from diffusers import ControlNetModel, StableDiffusionControlNetPipeline; \
import torch; \
cache = '/tmp/models'; \
dtype = torch.float16; \
print('Downloading ControlNet Canny…'); \
ControlNetModel.from_pretrained('lllyasviel/sd-controlnet-canny', torch_dtype=dtype, cache_dir=cache); \
print('Downloading ControlNet Depth…'); \
ControlNetModel.from_pretrained('lllyasviel/sd-controlnet-depth', torch_dtype=dtype, cache_dir=cache); \
print('Downloading ControlNet HED…'); \
ControlNetModel.from_pretrained('lllyasviel/sd-controlnet-hed', torch_dtype=dtype, cache_dir=cache); \
print('Downloading Stable Diffusion v1.5…'); \
cn = ControlNetModel.from_pretrained('lllyasviel/sd-controlnet-canny', torch_dtype=dtype, cache_dir=cache); \
StableDiffusionControlNetPipeline.from_pretrained('runwayml/stable-diffusion-v1-5', controlnet=cn, torch_dtype=dtype, cache_dir=cache, safety_checker=None); \
print('All models downloaded successfully.'); \
"

# Set environment for RunPod
ENV MODEL_CACHE_DIR=/tmp/models
ENV PRELOAD_MODELS=true
ENV ML_HOST=0.0.0.0
ENV ML_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
